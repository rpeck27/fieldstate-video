<?xml version="1.0" encoding="UTF-8"?>
<!-- NC place names a voice misreads. Aliases, for models other than
     eleven_v3/v4; those get the same names as inline IPA (lib/voice.mjs NC_IPA). -->
<lexicon version="1.0"
  xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
  alphabet="ipa" xml:lang="en-US">
  <lexeme><grapheme>Cabarrus</grapheme><alias>kuh BEAR us</alias></lexeme>
  <lexeme><grapheme>Buncombe</grapheme><alias>BUNG kum</alias></lexeme>
  <lexeme><grapheme>Guilford</grapheme><alias>GILL ferd</alias></lexeme>
  <lexeme><grapheme>Currituck</grapheme><alias>KUR ih tuck</alias></lexeme>
  <lexeme><grapheme>Chowan</grapheme><alias>chuh WAHN</alias></lexeme>
  <lexeme><grapheme>Rowan</grapheme><alias>roe AN</alias></lexeme>
  <lexeme><grapheme>Beaufort</grapheme><alias>BOH fert</alias></lexeme>
  <lexeme><grapheme>Bertie</grapheme><alias>ber TEE</alias></lexeme>
  <lexeme><grapheme>Perquimans</grapheme><alias>per KWIM unz</alias></lexeme>
  <lexeme><grapheme>Pasquotank</grapheme><alias>PASS kwuh tank</alias></lexeme>
  <lexeme><grapheme>Mebane</grapheme><alias>MEB in</alias></lexeme>
  <lexeme><grapheme>Manteo</grapheme><alias>MAN tee oh</alias></lexeme>
  <lexeme><grapheme>Pamlico</grapheme><alias>PAM lih koh</alias></lexeme>
  <lexeme><grapheme>Fuquay</grapheme><alias>FEW kway</alias></lexeme>
  <lexeme><grapheme>Varina</grapheme><alias>vuh REE nuh</alias></lexeme>
</lexicon>
